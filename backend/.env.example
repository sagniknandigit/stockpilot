ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stockpilot
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=["http://localhost:5173"]
# Optional: enables the 'Ask StockPilot' assistant (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: Redis enables multi-worker live updates/rate limits and background jobs (Celery)
REDIS_URL=redis://localhost:6379/0
# Optional: SMTP for alert emails (logged to the console when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=StockPilot <alerts@stockpilot.local>
APP_URL=http://localhost:5173
# Local development only: let webhooks target http:// and localhost URLs
WEBHOOKS_ALLOW_INSECURE_URLS=false
